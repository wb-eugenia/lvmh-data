                "Travel": {
                    "description": "Voyages, vacances, déplacements",
                    "examples": [
                        "Business_trip",
                        "Vacation",
                        "Weekend_getaway",
                        "Frequent_traveler"
                    ]
                },
                "Business": {
                    "description": "Usage professionnel, travail",
                    "examples": [
                        "Work_bag",
                        "Meeting_outfit",
                        "Professional_look",
                        "Office_use"
                    ]
                }
            }
        },
        "PREFERENCES": {
            "description": "Goûts, préférences esthétiques, style",
            "subcategories": {
                "Style": {
                    "description": "Style général, esthétique préférée",
                    "examples": [
                        "Minimalist_style",
                        "Classic_taste",
                        "Modern_look",
                        "Vintage_lover"
                    ]
                },
                "Materials": {
                    "description": "Préférences de matériaux, cuirs, textiles",
                    "examples": [
                        "Epi_leather_fan",
                        "Canvas_preference",
                        "Exotic_leather",
                        "Vegan_leather"
