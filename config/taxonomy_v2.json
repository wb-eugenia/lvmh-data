        "BUDGET": {
            "description": "Informations budgétaires et financières",
            "subcategories": {
                "Under_2K": {
                    "description": "Petit budget, budget entrée de gamme, moins de 2000 euros",
                    "examples": [
                        "500_euros_budget",
                        "1000_euros_max",
                        "Entry_level_budget",
                        "Affordable_gift"
                    ]
                },
                "2K_to_5K": {
                    "description": "Budget moyen, standard luxe, entre 2000 et 5000 euros",
                    "examples": [
                        "3000_euros_budget",
                        "4000_euros_max",
                        "Mid_range_budget",
                        "Standard_bag_price"
                    ]
                },
                "5K_to_10K": {
                    "description": "Budget élevé, premium, entre 5000 et 10000 euros",
                    "examples": [
                        "7000_euros_budget",
                        "High_end_budget",
                        "Premium_purchase",
                        "8000_euros_limit"
                    ]
                },
                "Over_10K": {
                    "description": "Très haut budget, plus de 10000 euros, exceptionnel",
                    "examples": [
                        "15000_euros_budget",
                        "20k_budget",
                        "High_jewelry_budget",
                        "Unlimited_budget_feel"
                    ]
                },
                "Flexible_No_Limit": {
                    "description": "Pas de limite, budget flexible, prix non important",
                    "examples": [
                        "No_budget_limit",
                        "Price_is_no_object",
                        "Flexible_spending",
                        "Open_budget"
                    ]
                }
            }
        }
    }
}