{
    "version": "2.0",
    "description": "Taxonomie hiérarchique LVMH pour classification par embeddings",
    "categories": {
        "CLIENT_PROFILE": {
            "description": "Informations sur le profil et l'identité du client",
            "subcategories": {
                "Demographics": {
                    "description": "Âge, genre, localisation, situation familiale du client",
                    "examples": [
                        "Young_professional",
                        "Paris_resident",
                        "Married",
                        "Mother_of_two"
                    ]
                },
                "Status": {
                    "description": "Statut client, fidélité, historique d'achat",
                    "examples": [
                        "VIC_client",
                        "New_client",
                        "Loyal_customer",
                        "First_visit"
                    ]
                },
                "Profession": {
                    "description": "Métier, secteur d'activité, niveau professionnel",
                    "examples": [
                        "Lawyer",
                        "Architect",
                        "CEO",
                        "Doctor",
                        "Artist"
                    ]
                }
            }
        },
        "PRODUCT": {
            "description": "Produits, articles et collections mentionnés",
            "subcategories": {
                "Bags": {
                    "description": "Sacs à main, pochettes, modèles iconiques",
                    "examples": [
                        "Capucines_bag",
                        "Neverfull_bag",
                        "Speedy_bag",
                        "Alma_bag",
                        "Pochette"
                    ]
                },
                "Leather_Goods": {
                    "description": "Petite maroquinerie, portefeuilles, ceintures",
                    "examples": [
                        "Leather_wallet",
                        "Card_holder",
                        "Belt",
                        "Passport_cover"
                    ]
                },
                "Accessories": {
                    "description": "Bijoux, montres, foulards, lunettes",
                    "examples": [
                        "Silver_necklace",
                        "Gold_bracelet",
                        "Silk_scarf",
                        "Sunglasses"
                    ]
                },
                "Ready_to_Wear": {
                    "description": "Vêtements, prêt-à-porter, chaussures",
                    "examples": [
                        "Leather_jacket",
                        "Cashmere_coat",
                        "Sneakers",
                        "Heels"
                    ]
                }
            }
        },
        "OCCASION": {
            "description": "Contexte d'achat, événement, raison",
            "subcategories": {
                "Gifts": {
                    "description": "Cadeaux pour autrui, anniversaires, célébrations",
                    "examples": [
                        "Wife_gift",
                        "Husband_gift",
                        "Birthday_gift",
                        "Christmas_gift",
                        "Wedding_gift"
                    ]
