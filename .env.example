# LLM keys
OPENAI_API_KEY=sk-your-api-key-here
MISTRAL_API_KEY=your-mistral-key-here
GROQ_API_KEY=your-groq-key-here

# Security
JWT_SECRET_KEY=replace-with-32-plus-char-random-secret
ENV=development
ALLOW_DEMO_ACCOUNTS=true
ALLOW_SEED_ENDPOINT=false
DEMO_PASSWORD=lvmh

# Database (SQLite local / Postgres prod)
DATABASE_URL=sqlite:///./lvmh.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
AUTO_CREATE_SCHEMA=true

# Optional feature flags
ENABLE_RGPD_LLM=1
RGPD_MODEL=gpt-4o-mini
PRELOAD_PIPELINE=1
JSON_LOGS=1
LOG_LEVEL=INFO

# API protection
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_WINDOW=120
RATE_LIMIT_LOGIN_PER_WINDOW=20
RATE_LIMIT_ANALYZE_PER_WINDOW=60
RATE_LIMIT_TRANSCRIBE_PER_WINDOW=20
RATE_LIMIT_STREAM_PER_WINDOW=30
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REDIS_RETRY_SECONDS=30

# Frontend runtime targets (for Cloudflare Pages builds)
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_BACKEND_PROXY_TARGET=http://localhost:8080
